+	if !remote.IsValid() || remote.Is4() != local.Is4() {
+		return errors.New("no refusal from ", remote, " to ", local)
+	}
+	proto, kind, code := byte(protoICMPv4), byte(3), byte(3)
+	if remote.Is6() {
+		proto, kind, code = protoICMPv6, 1, 4
+	}
+	m := make([]byte, 8+len(quote))
+	m[0], m[1] = kind, code
+	copy(m[8:], quote)
+	var b [ipv6HeaderSize]byte
+	n := putIPHeader(b[:], proto, remote, local)
+	if proto == protoICMPv6 {
+		binary.BigEndian.PutUint16(m[2:], transportChecksum(b[:n], protoICMPv6, m, nil))
+	} else {
+		binary.BigEndian.PutUint16(m[2:], checksum(sum(m, 0)))
+	}
+	if err := s.write(b[:n], m); err != nil {
+		return errors.New("failed to write a refusal").Base(err)
+	}
+	return nil
 }
 
